+#!/bin/bash
+
+# Test Authentication Flow Script
+# This script tests the new Passport.js authentication implementation
+
+BASE_URL="http://localhost:5000/api"
+
+echo "=== Testing Authentication Flow ==="
+echo ""
+
+# 1. Test login
+echo "1. Testing login endpoint..."
+LOGIN_RESPONSE=$(curl -s -c cookies.txt -X POST "$BASE_URL/auth/login" \
+  -H "Content-Type: application/json" \
+  -d '{"username": "admin", "password": "admin_password"}' \
+  -w "\nHTTP_STATUS:%{http_code}")
+
+HTTP_STATUS=$(echo "$LOGIN_RESPONSE" | grep -o "HTTP_STATUS:[0-9]*" | cut -d: -f2)
+BODY=$(echo "$LOGIN_RESPONSE" | sed 's/HTTP_STATUS:[0-9]*//')
+
+echo "Response Status: $HTTP_STATUS"
+echo "Response Body: $BODY"
+echo ""
+
+# Check if login was successful
+if [ "$HTTP_STATUS" -ne "200" ]; then
+  echo "❌ Login failed!"
+  exit 1
+fi
+
+echo "✅ Login successful!"
+echo ""
+
+# 2. Test protected endpoint with cookies
+echo "2. Testing protected endpoint with cookies..."
+PROTECTED_RESPONSE=$(curl -s -b cookies.txt -X GET "$BASE_URL/admin/library-items" \
+  -w "\nHTTP_STATUS:%{http_code}")
+
+HTTP_STATUS=$(echo "$PROTECTED_RESPONSE" | grep -o "HTTP_STATUS:[0-9]*" | cut -d: -f2)
+BODY=$(echo "$PROTECTED_RESPONSE" | sed 's/HTTP_STATUS:[0-9]*//')
+
+echo "Response Status: $HTTP_STATUS"
+echo "Response Body (truncated): ${BODY:0:100}..."
+echo ""
+
+if [ "$HTTP_STATUS" -eq "200" ]; then
+  echo "✅ Protected endpoint accessed successfully!"
+else
+  echo "❌ Failed to access protected endpoint!"
+fi
+echo ""
+
+# 3. Test token refresh
+echo "3. Testing token refresh..."
+REFRESH_RESPONSE=$(curl -s -b cookies.txt -c cookies.txt -X POST "$BASE_URL/auth/refresh" \
+  -w "\nHTTP_STATUS:%{http_code}")
+
+HTTP_STATUS=$(echo "$REFRESH_RESPONSE" | grep -o "HTTP_STATUS:[0-9]*" | cut -d: -f2)
+BODY=$(echo "$REFRESH_RESPONSE" | sed 's/HTTP_STATUS:[0-9]*//')
+
+echo "Response Status: $HTTP_STATUS"
+echo "Response Body: $BODY"
+echo ""
+
+if [ "$HTTP_STATUS" -eq "200" ]; then
+  echo "✅ Token refresh successful!"
+else
+  echo "❌ Token refresh failed!"
+fi
+echo ""
+
+# 4. Test logout
+echo "4. Testing logout..."
+LOGOUT_RESPONSE=$(curl -s -b cookies.txt -c cookies.txt -X POST "$BASE_URL/auth/logout" \
+  -w "\nHTTP_STATUS:%{http_code}")
+
+HTTP_STATUS=$(echo "$LOGOUT_RESPONSE" | grep -o "HTTP_STATUS:[0-9]*" | cut -d: -f2)
+BODY=$(echo "$LOGOUT_RESPONSE" | sed 's/HTTP_STATUS:[0-9]*//')
+
+echo "Response Status: $HTTP_STATUS"
+echo "Response Body: $BODY"
+echo ""
+
+if [ "$HTTP_STATUS" -eq "200" ]; then
+  echo "✅ Logout successful!"
+else
+  echo "❌ Logout failed!"
+fi
+echo ""
+
+# 5. Verify access is denied after logout
+echo "5. Testing protected endpoint after logout..."
+DENIED_RESPONSE=$(curl -s -b cookies.txt -X GET "$BASE_URL/admin/library-items" \
+  -w "\nHTTP_STATUS:%{http_code}")
+
+HTTP_STATUS=$(echo "$DENIED_RESPONSE" | grep -o "HTTP_STATUS:[0-9]*" | cut -d: -f2)
+BODY=$(echo "$DENIED_RESPONSE" | sed 's/HTTP_STATUS:[0-9]*//')
+
+echo "Response Status: $HTTP_STATUS"
+echo "Response Body: $BODY"
+echo ""
+
+if [ "$HTTP_STATUS" -eq "401" ]; then
+  echo "✅ Access correctly denied after logout!"
+else
+  echo "❌ Security issue: Protected endpoint still accessible after logout!"
+fi
+
+# Cleanup
+rm -f cookies.txt
+
+echo ""
+echo "=== Authentication Flow Test Complete ==="
